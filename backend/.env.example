PORT=4000
NODE_ENV=development

# Chemin du fichier SQLite
DB_PATH=./data/pharmacie.db

# Secrets JWT (changer en production - générer avec: openssl rand -hex 64)
JWT_SECRET=change_moi_en_production_avec_une_valeur_aleatoire_longue
JWT_EXPIRES_IN=8h

# Verrouillage de compte
MAX_TENTATIVES_ECHOUEES=5
DUREE_VERROUILLAGE_MINUTES=15

# CORS - origine autorisée du frontend
FRONTEND_ORIGIN=http://localhost:5173

# Pharmacie par défaut (créée au premier démarrage)
PHARMACY_NOM_DEFAUT="Pharmacie Principale"
ADMIN_NOM_DEFAUT=Administrateur
ADMIN_TELEPHONE_DEFAUT=+243900000000
ADMIN_MOT_DE_PASSE_DEFAUT=ChangeMoi123!

# SMS (Africa's Talking) - optionnel. Sans ces variables, l'envoi de reçu
# par SMS est simplement désactivé (le lien WhatsApp reste disponible,
# lui, sans aucune configuration).
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=
